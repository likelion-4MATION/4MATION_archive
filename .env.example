# 앱 기본값은 HCX 유지. 로컬 실험에서만 deepseek로 바꾼다: hcx | deepseek
LLM_PROVIDER=hcx

# DeepSeek API — 실키는 .env에만 (커밋 금지)
DEEPSEEK_API_KEY=
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash

# CLOVA Studio HCX
CLOVA_API_KEY=
CLOVA_API_URL=
CLOVA_MODEL=HCX-003

# ===== 질의 BF 라우터 체크포인트(선택) =====
# 없어도 검색은 돈다(키워드 분류로 폴백). 라우터를 쓰려면 read 권한 토큰이 필요하다.
# 발급: https://huggingface.co/settings/tokens · 상세: docs/router_checkpoint.md
HF_TOKEN=
# 기본값은 crawler/data/router_manifest.json 의 hf_repo. 다른 체크포인트로 A/B 할 때만 설정.
ROUTER_HF_REPO=
# 로컬 경로를 강제할 때만 설정(최우선). 비워두면 자동 해석.
ROUTER_PATH=
